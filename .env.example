# Copy to .env and set unique passwords before starting.
COMPOSE_PROJECT_NAME=xianyu-local
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
MYSQL_ROOT_PASSWORD=
MYSQL_USER=xianyu
MYSQL_PASSWORD=
MYSQL_DATABASE=xianyu_data
REDIS_PASSWORD=
# Optional local media folders; empty values use your home Desktop/Documents.
OPERATIONS_DESKTOP_ROOT=
OPERATIONS_DOCUMENTS_ROOT=
FRONTEND_PUBLIC_URL=http://localhost:9000
BACKEND_WEB_PUBLIC_URL=http://localhost:8089
# Optional: your own Amap inputtips key for location search.
AMAP_WEB_KEY=
